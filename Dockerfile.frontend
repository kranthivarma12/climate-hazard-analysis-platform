FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM node:22-alpine AS runner

WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev

COPY --from=builder /app/dist ./dist
COPY server.ts ./
COPY vite.config.ts ./
COPY tsconfig.json ./

EXPOSE 3000

ENV NODE_ENV=production \
    PORT=3000

CMD ["npx", "tsx", "server.ts"]
